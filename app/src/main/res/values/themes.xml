<?xml version="1.0" encoding="utf-8"?>
<!--This themes.xml is used for SDK 27 or under Android 12 versions-->
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="Theme.MultimediaNusantaraClinic" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
    </style>
    <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/mnclogosvg</item>
<!--    The reason for creating a separate themes.xml is for image branding
        The SplashScreen library for image branding only works on SDK 31 and above
        (Not applicable on versions under Android 12)-->
        <item name="android:windowBackground">@drawable/imagebrandingitem</item>
        <item name="postSplashScreenTheme">@style/Theme.MultimediaNusantaraClinic</item>
    </style>
</resources>